{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.noornote.desktop",
  "productName": "Noornote",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.social-networking",
    "icon": "public/favicon.png",
    "extraResources": [
      {
        "from": "binaries/darwin-arm64/",
        "to": "binaries/",
        "filter": ["noorsigner"]
      }
    ]
  },
  "linux": {
    "target": ["deb", "AppImage", "tar.gz"],
    "category": "Network",
    "icon": "public/favicon.png",
    "extraResources": [
      {
        "from": "binaries/linux-${arch}/",
        "to": "binaries/",
        "filter": ["noorsigner"]
      }
    ]
  }
}
