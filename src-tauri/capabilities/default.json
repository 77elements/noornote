{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shared permissions for all platforms",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "log:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$DOWNLOAD/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.noornote" },
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.noornote" },
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/.noornote" },
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/.noornote" },
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$HOME/.noornote" },
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/.noornote" },
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$HOME/.noornote/**/*" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    "http:default",
    "http:allow-fetch",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "core:window:allow-set-badge-count"
  ]
}
