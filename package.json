{
  "name": "noornote",
  "version": "0.7.1",
  "description": "Feature-rich, fast, secure Nostr client",
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && bun run build:static-css",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .js,.ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,css,html}\"",
    "bundle-analyzer": "vite-bundle-analyzer",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "electron:dev": "ELECTRON_DEV_MODE=wide npx electron .",
    "electron:build": "electron-builder",
    "build:static-css": "sass src/styles/static-pages.scss public/static.css --style=compressed --no-source-map",
    "render-banners": "node marketing/banners/generate-pngs.js",
    "prepare": "husky"
  },
  "keywords": [
    "nostr",
    "web-client",
    "decentralized",
    "social",
    "vanilla-js",
    "performance"
  ],
  "author": "Alp <outreach.trend196@4wrd.cc>",
  "license": "MIT",
  "homepage": "https://github.com/77elements/noornote#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/77elements/noornote.git"
  },
  "bugs": {
    "url": "https://github.com/77elements/noornote/issues"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.8.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitest/coverage-v8": "^0.34.0",
    "@vitest/ui": "^0.34.0",
    "electron": "41.1.1",
    "electron-builder": "26.8.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.0.3",
    "puppeteer": "^24.37.5",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass-embedded": "^1.93.2",
    "typescript": "^5.2.0",
    "vite": "^7.1.11",
    "vite-bundle-analyzer": "^0.7.0",
    "vitest": "^0.34.0"
  },
  "dependencies": {
    "@calidy/dayjs-calendarsystems": "^2.0.0",
    "@capacitor/android": "8.1.0",
    "@capacitor/app": "8.1.0",
    "@capacitor/cli": "8.3.0",
    "@capacitor/core": "8.3.0",
    "@capacitor/filesystem": "8.1.2",
    "@noble/ciphers": "^0.5.3",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@nostr-dev-kit/ndk-cache-dexie": "file:vendor/ndk-cache-dexie",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.3.1",
    "@scure/bip39": "^1.2.1",
    "bech32": "^2.0.0",
    "dataloader": "^2.2.2",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.2",
    "emojilib": "^4.0.2",
    "fflate": "^0.8.2",
    "marked": "^16.4.0",
    "nostr-signer-capacitor-plugin": "^0.0.5",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not op_mini all"
  ]
}
